{
  "name": "erp-sistema",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:ai\"",
    "dev:web": "pnpm --filter @erp/web dev",
    "dev:api": "pnpm --filter @erp/api start:dev",
    "dev:ai": "cd apps/ai && .venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000",
    "setup:ai": "cd apps/ai && python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "prisma:generate": "pnpm --filter @erp/api exec prisma generate",
    "db:migrate": "pnpm --filter @erp/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @erp/api exec prisma db seed",
    "build": "pnpm build:shared && pnpm prisma:generate && pnpm build:web && pnpm build:api",
    "build:shared": "pnpm --filter @erp/shared build",
    "build:web": "pnpm --filter @erp/web build",
    "build:api": "pnpm --filter @erp/api build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm type-check:shared && pnpm type-check:web && pnpm type-check:api",
    "type-check:shared": "pnpm --filter @erp/shared type-check",
    "type-check:web": "pnpm --filter @erp/web type-check",
    "type-check:api": "pnpm --filter @erp/api type-check"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
