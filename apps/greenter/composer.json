{
  "name": "inventori/greenter-sidecar",
  "description": "Sidecar HTTP para emitir CPE SUNAT con Greenter desde Inventori ERP.",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "greenter/lite": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "Inventori\\Greenter\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "optimize-autoloader": true
  }
}
