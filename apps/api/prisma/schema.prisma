}

model Caja {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activa      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  aperturas AperturaCaja[]

  @@map("cajas")
}

model AperturaCaja {
  id                String     @id @default(uuid())
  cajaId            String
  usuarioAperturaId String
  usuarioCierreId   String?
  estado            EstadoCaja @default(ABIERTA)
  montoInicial      Decimal    @db.Decimal(12, 2)
  montoEsperado     Decimal?   @db.Decimal(12, 2)
  montoContado      Decimal?   @db.Decimal(12, 2)
  diferencia        Decimal?   @db.Decimal(12, 2)
  notasApertura     String?
  notasCierre       String?
  abiertaEn         DateTime   @default(now())
  cerradaEn         DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  caja            Caja             @relation(fields: [cajaId], references: [id])
  usuarioApertura Usuario          @relation("AperturaUsuario", fields: [usuarioAperturaId], references: [id])
  usuarioCierre   Usuario?         @relation("CierreUsuario", fields: [usuarioCierreId], references: [id])
  movimientos     MovimientoCaja[]
  arqueos         ArqueoCaja[]

  @@index([cajaId])
  @@index([usuarioAperturaId])
  @@index([usuarioCierreId])
  @@index([estado])
  @@map("aperturas_caja")
}

model MovimientoCaja {
  id             String             @id @default(uuid())
  aperturaId     String
  tipo           TipoMovimientoCaja
  monto          Decimal            @db.Decimal(12, 2)
  metodoPagoId   String?
  concepto       String
  referenciaTipo String?
  referenciaId   String?
  usuarioId      String
  createdAt      DateTime           @default(now())

  apertura   AperturaCaja @relation(fields: [aperturaId], references: [id])
  metodoPago MetodoPago?  @relation(fields: [metodoPagoId], references: [id])
  usuario    Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([aperturaId])
  @@index([metodoPagoId])
  @@index([usuarioId])
  @@index([referenciaTipo, referenciaId])
  @@map("movimientos_caja")
}

model ArqueoCaja {
  id            String   @id @default(uuid())
  aperturaId    String
  usuarioId     String
  montoEsperado Decimal  @db.Decimal(12, 2)
  montoContado  Decimal  @db.Decimal(12, 2)
  diferencia    Decimal  @db.Decimal(12, 2)
  notas         String?
  createdAt     DateTime @default(now())

  apertura AperturaCaja @relation(fields: [aperturaId], references: [id])
  usuario  Usuario      @relation(fields: [usuarioId], references: [id])

  @@index([aperturaId])
  @@index([usuarioId])
  @@map("arqueos_caja")
}

// ─────────────────────────────────────────────────────────────────────
//  Solicitudes públicas (landing → gestión interna)
// ─────────────────────────────────────────────────────────────────────

enum NecesidadSolicitud {
  VENTA
  ALQUILER
  SOPORTE
  CONSUMIBLES
  OTRO
}

enum EstadoSolicitud {
  NUEVA
  EN_PROCESO
  ATENDIDA
  DESCARTADA
}

/// Solicitud llegada desde el formulario público del landing. La crea
/// cualquier visitante sin autenticación (rate-limited) y la gestiona
/// el equipo ADMIN/ENCARGADO desde el módulo /solicitudes del ERP.
model SolicitudPublica {
  id            String             @id @default(uuid())
  empresa       String
  contacto      String
  necesidad     NecesidadSolicitud
  detalle       String?
  origen        String             @default("web-landing")
  ip            String?
  userAgent     String?

  estado        EstadoSolicitud    @default(NUEVA)
  asignadoAId   String?
  asignadoA     Usuario?           @relation("SolicitudAsignada", fields: [asignadoAId], references: [id])
  notasInternas String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  atendidaAt    DateTime?

  @@index([estado])
  @@index([asignadoAId])
  @@index([createdAt(sort: Desc)])
  @@map("solicitudes_publicas")
}
