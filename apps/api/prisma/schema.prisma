// ERP Sistema — Schema Prisma
// Core configurable para catálogo, inventario, ventas, soporte y facturación

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────

enum RolUsuario {
  ADMIN
  ENCARGADO
  TECNICO
}

enum TipoCliente {
  NATURAL
  EMPRESA
}

enum EstadoTicket {
  ABIERTO
  EN_PROCESO
  EN_ESPERA
  CERRADO
  CANCELADO
}

enum PrioridadTicket {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TipoServicio {
  TALLER
  VISITA
  REMOTO
}

enum TipoMovimiento {
  COMPRA_RECIBIDA
  VENTA
  CONSUMO_SOPORTE
  DEVOLUCION_CLIENTE
  DEVOLUCION_PROVEEDOR
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  TRANSFERENCIA
  BAJA_DANO
}

enum MovimientoComportamiento {
  ENTRADA
  SALIDA
  TRANSFERENCIA
}

enum EstadoOrdenCompra {
  BORRADOR
  APROBADA
  ENVIADA_PROVEEDOR
  RECIBIDA_PARCIAL
  RECIBIDA_TOTAL
  CANCELADA
}

enum EstadoVenta {
  COTIZACION
  RESERVADA
  ORDEN_CONFIRMADA
  ENTREGADA
  CANCELADA
}

// Eje fiscal de la venta. Separado del comercial (D7).
// Solo lo modifica el dominio Comprobantes vía eventos.
enum EstadoFacturacionVenta {
  SIN_COMPROBANTE
  VENTA_INTERNA
  EN_EMISION
  EMITIDA
  EMITIDA_CON_OBS
  RECHAZADA
  ANULADA_FISCAL
}

enum TipoDocumento {
  FACTURA
  BOLETA
  NOTA_CREDITO
  NOTA_DEBITO
}

// Set canónico definido en doc 01 §3.3.
enum EstadoComprobante {
  PENDIENTE_ENVIO
  EN_PROCESO_SUNAT
  ACEPTADO
  ACEPTADO_CON_OBSERVACIONES
  RECHAZADO
  REQUIERE_REVISION
  BAJA_PENDIENTE
  ANULADO
}

enum TipoEnvio {
  ENVIO_INICIAL
  REINTENTO
  CONSULTA_TICKET
  COMUNICACION_BAJA
}

enum EstadoComunicacionBaja {
  PENDIENTE
  EN_PROCESO
  ACEPTADA
  RECHAZADA
}

enum TipoFiscalProducto {
  BIEN
  SERVICIO
}

enum TipoAfectacionIgv {
  GRAVADO_OPERACION_ONEROSA
  EXONERADO_OPERACION_ONEROSA
  INAFECTO_OPERACION_ONEROSA
  EXPORTACION
}

enum AmbienteSunat {
  BETA
  PRODUCCION
}

enum ModalidadEnvioBoletas {
  INDIVIDUAL
  RESUMEN
}

enum CertificadoStorageProvider {
  LOCAL_PRIVATE
  MINIO_PRIVATE
  SECRET_MANAGER
}

enum EstadoGarantia {
  PENDIENTE_COMPLETAR
  ACTIVA
  VENCIDA
  ANULADA
}

enum EstadoEquipo {
  ACTIVO
  EN_REPARACION
  BAJA
}

enum TipoProducto {
  EQUIPO
  REPUESTO
  INSUMO
  SERVICIO
  ACCESORIO
}

enum CondicionProducto {
  NUEVO
  SEMINUEVO
  USADO
  REACONDICIONADO
  RECUPERADO
}

enum EstadoComercialEquipo {
  DISPONIBLE
  VENDIDO
  ALQUILADO
  RESERVADO
  EN_REPARACION
  USO_INTERNO
  BAJA
}

enum EstadoContratoAlquiler {
  BORRADOR
  RESERVADO
  PENDIENTE_ENTREGA
  ACTIVO
  EN_RETORNO
  CERRADO
  FINALIZADO
  CANCELADO
}

enum EstadoPeriodoAlquiler {
  PENDIENTE_BASE
  ACTIVO
  PENDIENTE_CIERRE
  CERRADO
  CANCELADO
}

enum TipoCargoAlquiler {
  BASE
  DEPOSITO_GARANTIA
  EXCEDENTE_COPIAS
  SOPORTE
  DANO
  MORA
  TRANSPORTE
  AJUSTE
}

enum TipoInspeccionAlquiler {
  ENTREGA
  RETORNO
}

enum CondicionInspeccionAlquiler {
  BUENO
  REGULAR
  DANADO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO
  EGRESO
  VENTA
  DEVOLUCION
  RETIRO
  DEPOSITO
  AJUSTE
}

// ─── MODELOS ─────────────────────────────────────────

model Usuario {
  id                 String     @id @default(uuid())
  nombre             String
  apellido           String
  email              String     @unique
  /// Marca cuando el usuario verificó su correo con el OTP enviado al registrarse.
  /// Sin verificación, la cuenta no puede activarse desde admin.
  emailVerificado    Boolean    @default(false)
  emailVerificadoAt  DateTime?
  password           String
  rol                RolUsuario
  activo             Boolean    @default(true)
  mustChangePassword Boolean    @default(false)
  ultimoAcceso       DateTime?
  telefono           String?
  celular            String?
  whatsapp           String?
  direccion          String?
  cargo              String?
  bio                String?
  avatarUrl          String?
  sessionVersion     Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?

  contactosCliente ContactoCliente[]
  movimientosStock MovimientoStock[]
  ordenesCompra    OrdenCompra[]
  ventas           Venta[]
  ticketsAsignados Ticket[]          @relation("TecnicoTickets")
  ticketsCreados   Ticket[]          @relation("CreadorTickets")
  historialTickets HistorialTicket[]
  auditorias       Auditoria[]
  refreshTokens    RefreshToken[]
  emailOtps        EmailVerificationOtp[]
  passwordResets   PasswordResetToken[]
  alertasResueltas AlertaStock[]     @relation("ResueltaPor")
  aperturasCaja    AperturaCaja[]    @relation("AperturaUsuario")
  cierresCaja      AperturaCaja[]    @relation("CierreUsuario")
  movimientosCaja  MovimientoCaja[]
  arqueosCaja      ArqueoCaja[]
  solicitudesAsignadas SolicitudPublica[] @relation("SolicitudAsignada")
  contratosAlquilerCreados ContratoAlquiler[] @relation("ContratoAlquilerCreador")
  lecturasAlquiler LecturaAlquiler[]
  inspeccionesAlquiler InspeccionAlquiler[]

  @@map("usuarios")
}

/// OTP de 6 dígitos enviado al correo del usuario al registrarse, para
/// confirmar que el email es real antes de que un admin pueda activar
/// la cuenta. El código se guarda hasheado (bcrypt) para no exponerlo si
/// la BD se compromete. `intentos` permite limitar fuerza bruta.
model EmailVerificationOtp {
  id        String    @id @default(uuid())
  usuarioId String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  intentos  Int       @default(0)
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, usedAt])
  @@map("email_verification_otps")
}

/// Token de restablecimiento de contraseña enviado por email. Se guarda solo
/// un hash del identificador interno para poder consumirlo una sola vez.
model PasswordResetToken {
  id        String    @id @default(uuid())
  usuarioId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Cliente {
  id           String      @id @default(uuid())
  tipo         TipoCliente
  nombre       String?
  apellido     String?
  dni          String?     @unique
  razonSocial  String?
  ruc          String?     @unique
  email        String?
  telefono     String?
  celular      String?
  direccion    String?
  distrito     String?
  provincia    String?
  departamento String?
  referencia   String?
  latitud      Float?
  longitud     Float?
  notas        String?
  esGenerico   Boolean     @default(false)
  activo       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  contactos         ContactoCliente[]
  equipoClientes    EquipoCliente[]
  equiposCliente    EquipoClienteActivo[]
  ventas            Venta[]
  tickets           Ticket[]
  validacionesSunat ClienteValidacionSunat[]
  contratosAlquiler ContratoAlquiler[]

  @@map("clientes")
}

model ContactoCliente {
  id          String   @id @default(uuid())
  clienteId   String
  tipo        String
  descripcion String
  fecha       DateTime @default(now())
  usuarioId   String?
  createdAt   DateTime @default(now())

  cliente Cliente  @relation(fields: [clienteId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([clienteId])
  @@index([usuarioId])
  @@map("contactos_cliente")
}

model Proveedor {
  id               String    @id @default(uuid())
  razonSocial      String
  ruc              String    @unique
  email            String?
  telefono         String?
  celular          String?
  direccion        String?
  distrito         String?
  provincia        String?
  departamento     String?
  referencia       String?
  latitud          Float?
  longitud         Float?
  contactoNombre   String?
  contactoTelefono String?
  notas            String?
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  productoProveedores ProductoProveedor[]
  ordenesCompra       OrdenCompra[]

  @@map("proveedores")
}

model Categoria {
  id          String       @id @default(uuid())
  nombre      String
  descripcion String?
  tipo        TipoProducto @default(REPUESTO)
  padreId     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  padre     Categoria?  @relation("CategoriaHijos", fields: [padreId], references: [id])
  hijos     Categoria[] @relation("CategoriaHijos")
  productos Producto[]

  @@index([padreId])
  @@index([tipo])
  @@map("categorias")
}

model Marca {
  id        String         @id @default(uuid())
  nombre    String
  tipos     TipoProducto[] @default([EQUIPO])
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  productos Producto[]
  modelos   ModeloCatalogo[]

  @@map("marcas")
}

model ModeloCatalogo {
  id          String       @id @default(uuid())
  nombre      String
  descripcion String?
  tipo        TipoProducto @default(EQUIPO)
  marcaId     String?
  activo      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  marca                   Marca?                         @relation(fields: [marcaId], references: [id])
  productos               Producto[]
  productosCompatibilidad ProductoModeloCompatibilidad[]

  @@index([tipo])
  @@index([marcaId])
  @@map("modelos_catalogo")
}

model ProductoModeloCompatibilidad {
  id               String   @id @default(uuid())
  productoId       String
  modeloCatalogoId String
  createdAt        DateTime @default(now())

  producto       Producto       @relation(fields: [productoId], references: [id], onDelete: Cascade)
  modeloCatalogo ModeloCatalogo @relation(fields: [modeloCatalogoId], references: [id], onDelete: Cascade)

  @@unique([productoId, modeloCatalogoId])
  @@index([productoId])
  @@index([modeloCatalogoId])
  @@map("producto_modelo_compatibilidades")
}

model UnidadMedida {
  id          String    @id @default(uuid())
  codigo      String    @unique
  nombre      String
  descripcion String?
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  productos Producto[]

  @@map("unidades_medida")
}

model Producto {
  id                String             @id @default(uuid())
  sku               String             @unique
  nombre            String
  descripcion       String?
  tipo              TipoProducto       @default(REPUESTO)
  categoriaId       String
  marcaId           String?
  modeloCatalogoId  String?
  unidadMedidaId    String
  modelo            String?
  codigoBarras      String?            @unique
  codigoQr          String?            @unique
  condicion         CondicionProducto?
  precioCompra      Decimal            @db.Decimal(10, 2)
  precioVenta       Decimal            @db.Decimal(10, 2)
  precioMinimo      Decimal            @db.Decimal(10, 2)
  stockMinimo       Int                @default(0)
  manejaInventario  Boolean            @default(true)
  tieneNumeroSerie  Boolean            @default(false)
  esConsumible      Boolean            @default(false)
  requiereRepuestos Boolean            @default(false)
  tiempoEstimadoMin Int?
  mesesGarantia     Int                @default(12)
  garantiaMaxCopias Int?
  imagen            String?
  atributos         Json?
  activo            Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  categoria                    Categoria            @relation(fields: [categoriaId], references: [id])
  marca                        Marca?               @relation(fields: [marcaId], references: [id])
  modeloCatalogo               ModeloCatalogo?      @relation(fields: [modeloCatalogoId], references: [id])
  modelosCompatibles           ProductoModeloCompatibilidad[]
  unidadMedida                 UnidadMedida         @relation(fields: [unidadMedidaId], references: [id])
  imagenes                     ProductoImagen[]
  productoProveedores          ProductoProveedor[]
  compatibilidadesComoRepuesto Compatibilidad[]     @relation("RepuestoCompatibilidad")
  compatibilidadesComoModelo   Compatibilidad[]     @relation("ModeloCompatibilidad")
  equipos                      Equipo[]
  equiposCliente               EquipoClienteActivo[]
  almacenStocks                AlmacenStock[]
  movimientosStock             MovimientoStock[]
  detallesOrdenCompra          DetalleOrdenCompra[]
  detallesRecepcion            DetalleRecepcion[]
  detallesVenta                DetalleVenta[]
  detallesTicket               DetalleTicket[]
  comprobanteDetalles          ComprobanteDetalle[]
  alertasStock                 AlertaStock[]

  @@index([categoriaId])
  @@index([marcaId])
  @@index([modeloCatalogoId])
  @@index([unidadMedidaId])
  @@index([tipo])
  @@index([condicion])
  @@map("productos")
}

model ProductoImagen {
  id          String   @id @default(uuid())
  productoId  String
  url         String
  nombre      String?
  tipo        String?
  tamano      Int?
  esPrincipal Boolean  @default(false)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())

  producto Producto @relation(fields: [productoId], references: [id])

  @@index([productoId])
  @@map("producto_imagenes")
}

model ProductoProveedor {
  id              String   @id @default(uuid())
  productoId      String
  proveedorId     String
  codigoProveedor String?
  precioCompra    Decimal? @db.Decimal(10, 2)
  esPrincipal     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  producto  Producto  @relation(fields: [productoId], references: [id])
  proveedor Proveedor @relation(fields: [proveedorId], references: [id])

  @@unique([productoId, proveedorId])
  @@index([productoId])
  @@index([proveedorId])
  @@map("producto_proveedores")
}

model Compatibilidad {
  id         String   @id @default(uuid())
  repuestoId String
  modeloId   String
  notas      String?
  createdAt  DateTime @default(now())

  repuesto Producto @relation("RepuestoCompatibilidad", fields: [repuestoId], references: [id])
  modelo   Producto @relation("ModeloCompatibilidad", fields: [modeloId], references: [id])

  @@unique([repuestoId, modeloId])
  @@index([repuestoId])
  @@index([modeloId])
  @@map("compatibilidades")
}

model Equipo {
  id                String                @id @default(uuid())
  numeroSerie       String                @unique
  productoId        String
  almacenId         String?
  estado            EstadoEquipo          @default(ACTIVO)
  estadoComercial   EstadoComercialEquipo @default(DISPONIBLE)
  condicion         CondicionProducto?
  procedencia       String?
  contadorInicial   Int?
  contadorActual    Int?
  fechaIngreso      DateTime?
  observacionEstado String?
  codigoQr          String?               @unique
  ubicacion         String?
  firmware          String?
  notas             String?
  ipAddress         String?
  snmpCommunity     String?               @default("public")
  snmpPort          Int?                  @default(161)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?

  producto       Producto        @relation(fields: [productoId], references: [id])
  almacen        Almacen?        @relation(fields: [almacenId], references: [id])
  equipoClientes EquipoCliente[]
  lecturasSNMP   LecturaSNMP[]
  lecturasAlquiler LecturaAlquiler[]
  inspeccionesAlquiler InspeccionAlquiler[]
  garantias      Garantia[]
  tickets        Ticket[]
  contratosAlquiler ContratoAlquiler[]

  @@index([productoId])
  @@index([almacenId])
  @@index([estadoComercial])
  @@index([condicion])
  @@map("equipos")
}

model EquipoCliente {
  id          String    @id @default(uuid())
  equipoId    String
  clienteId   String
  ventaId     String?
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  notas       String?
  createdAt   DateTime  @default(now())

  equipo  Equipo  @relation(fields: [equipoId], references: [id])
  cliente Cliente @relation(fields: [clienteId], references: [id])
  venta   Venta?  @relation(fields: [ventaId], references: [id])

  @@index([equipoId])
  @@index([clienteId])
  @@index([ventaId])
  @@map("equipo_clientes")
}

model EquipoClienteActivo {
  id             String       @id @default(uuid())
  clienteId      String
  productoId     String?
  numeroSerie    String
  nombre         String?
  marca          String?
  modelo         String?
  estado         EstadoEquipo @default(ACTIVO)
  codigoQr       String?      @unique
  ubicacion      String?
  notas          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  cliente  Cliente  @relation(fields: [clienteId], references: [id])
  producto Producto? @relation(fields: [productoId], references: [id])
  tickets  Ticket[]

  @@unique([clienteId, numeroSerie])
  @@index([clienteId])
  @@index([productoId])
  @@index([estado])
  @@map("equipos_cliente")
}

model ContratoAlquiler {
  id                    String                 @id @default(uuid())
  numero                String                 @unique
  clienteId             String
  equipoId              String
  creadoPorId           String
  fechaInicio           DateTime
  fechaFinPrevista      DateTime
  mesesPlazo            Int                    @default(6)
  copiasIncluidasMes    Int
  precioMensual         Decimal                @db.Decimal(10, 2)
  precioCopiaExcedente  Decimal                @db.Decimal(10, 4)
  depositoGarantia      Decimal                @default(0) @db.Decimal(10, 2)
  depositoCobradoAt     DateTime?
  depositoDevueltoAt    DateTime?
  depositoAplicado      Decimal                @default(0) @db.Decimal(10, 2)
  contadorInicio        Int
  contadorActual        Int?
  estado                EstadoContratoAlquiler @default(BORRADOR)
  notas                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  cliente   Cliente          @relation(fields: [clienteId], references: [id])
  equipo    Equipo           @relation(fields: [equipoId], references: [id])
  creadoPor Usuario          @relation("ContratoAlquilerCreador", fields: [creadoPorId], references: [id])
  garantia  Garantia?
  periodos  PeriodoAlquiler[]
  lecturas  LecturaAlquiler[]
  inspecciones InspeccionAlquiler[]

  @@index([clienteId])
  @@index([equipoId])
  @@index([creadoPorId])
  @@index([estado])
  @@map("contratos_alquiler")
}

model PeriodoAlquiler {
  id                String                @id @default(uuid())
  contratoId        String
  numeroPeriodo     Int
  fechaInicio       DateTime
  fechaFin          DateTime
  lecturaInicial    Int?
  lecturaFinal      Int?
  copiasUsadas      Int?
  copiasIncluidas   Int
  copiasExcedentes  Int?
  montoBase         Decimal               @db.Decimal(10, 2)
  montoExcedente    Decimal               @default(0) @db.Decimal(10, 2)
  montoSoporte      Decimal               @default(0) @db.Decimal(10, 2)
  totalCierre       Decimal               @default(0) @db.Decimal(10, 2)
  baseCobradoAt     DateTime?
  cierreCalculadoAt DateTime?
  cierreCobradoAt   DateTime?
  estado            EstadoPeriodoAlquiler @default(PENDIENTE_BASE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  contrato ContratoAlquiler @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  lecturas LecturaAlquiler[]
  cargos   CargoPeriodoAlquiler[]

  @@unique([contratoId, numeroPeriodo])
  @@index([contratoId])
  @@index([estado])
  @@index([fechaInicio, fechaFin])
  @@map("periodos_alquiler")
}

model LecturaAlquiler {
  id           String   @id @default(uuid())
  contratoId   String
  periodoId    String?
  equipoId     String
  usuarioId    String
  contador     Int
  fechaLectura DateTime @default(now())
  notas        String?
  createdAt    DateTime @default(now())

  contrato ContratoAlquiler @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  periodo  PeriodoAlquiler? @relation(fields: [periodoId], references: [id], onDelete: SetNull)
  equipo   Equipo           @relation(fields: [equipoId], references: [id])
  usuario  Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([contratoId])
  @@index([periodoId])
  @@index([equipoId])
  @@index([usuarioId])
  @@map("lecturas_alquiler")
}

model InspeccionAlquiler {
  id                String                       @id @default(uuid())
  contratoId        String
  equipoId          String
  usuarioId         String
  tipo              TipoInspeccionAlquiler
  condicion         CondicionInspeccionAlquiler
  contador          Int?
  evidenciaFilename String?
  notas             String?
  createdAt         DateTime                     @default(now())

  contrato ContratoAlquiler @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  equipo   Equipo           @relation(fields: [equipoId], references: [id])
  usuario  Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([contratoId])
  @@index([equipoId])
  @@index([usuarioId])
  @@index([tipo])
  @@map("inspecciones_alquiler")
}

model CargoPeriodoAlquiler {
  id          String            @id @default(uuid())
  periodoId   String
  tipo        TipoCargoAlquiler
  ticketId    String?
  descripcion String
  monto       Decimal           @db.Decimal(10, 2)
  createdAt   DateTime          @default(now())

  periodo PeriodoAlquiler @relation(fields: [periodoId], references: [id], onDelete: Cascade)
  ticket  Ticket?         @relation(fields: [ticketId], references: [id])

  @@unique([periodoId, tipo, ticketId])
  @@index([periodoId])
  @@index([ticketId])
  @@index([tipo])
  @@map("cargos_periodo_alquiler")
}

model LecturaSNMP {
  id                 String   @id @default(uuid())
  equipoId           String
