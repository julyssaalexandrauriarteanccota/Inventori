model Comprobante {
  id                          String            @id @default(uuid())
  // ventaId es opcional porque NC/ND no representan una venta nueva,
  // sino que apuntan a otro Comprobante vía `comprobanteOrigenId`.
  // Postgres permite múltiples NULLs en UNIQUE, así garantiza una sola
  // factura/boleta por venta sin restringir las notas asociadas.
  ventaId                     String?           @unique
  tipo                        TipoDocumento
  serie                       String
  correlativo                 Int
  numero                      String            @unique

  // Snapshot fiscal inmutable (D8). Estructura definida en doc 01 \u00a74.1.
  // Mientras se completa la migraci\u00f3n desde campos planos, se mantiene
  // opcional; los nuevos comprobantes deben poblarlo al emitir.
  snapshot                    Json?
  ambiente                    AmbienteSunat     @default(BETA)

  // Snapshot fiscal en forma plana (LEGACY pre-doc-01). Migrar a `snapshot`
  // y vaciar en doc 07. No usar en c\u00f3digo nuevo.
  clienteNombre               String
  clienteDocTipo              String
  clienteDocNum               String
  clienteDireccion            String?
  emisorRuc                   String?
  emisorRazonSocial           String?
  emisorNombreComercial       String?
  emisorDireccionFiscal       String?
  emisorUbigeoFiscal          String?
  emisorDepartamentoFiscal    String?
  emisorProvinciaFiscal       String?
  emisorDistritoFiscal        String?
  emisorCodigoEstablecimiento String?
  subtotal                    Decimal           @db.Decimal(10, 2)
  igv                         Decimal           @db.Decimal(10, 2)
  total                       Decimal           @db.Decimal(10, 2)
  estado                      EstadoComprobante @default(PENDIENTE_ENVIO)

  // Notas de cr\u00e9dito / d\u00e9bito: auto-relaci\u00f3n al comprobante origen.
  // Reemplaza modelos NotaCredito/NotaDebito (a unificar en doc 05).
  comprobanteOrigenId         String?
  comprobanteOrigen           Comprobante?      @relation("ComprobanteNotas", fields: [comprobanteOrigenId], references: [id])
  notas                       Comprobante[]    @relation("ComprobanteNotas")
  motivoNota                  String?           // Cat 09 (NC) o Cat 10 (ND)
  motivoNotaDescripcion       String?
  esNotaExcepcional           Boolean           @default(false)

  // Trazabilidad SUNAT
  operationId                 String?           @unique // idempotencia env\u00edo
  ticketSunat                 String?
  hashCpe                     String?           // digestValue del XML firmado
  // Doc 06 \u00a74 \u2014 SHA-256 del XML firmado, base de la idempotencia entre intentos.
  payloadHash                 String?
  // Doc 06 \u00a75 \u2014 Plazo legal m\u00e1ximo para que SUNAT reciba el comprobante.
  fechaVencimientoPlazo       DateTime?

  // Storage documental (MinIO). El contenido NO va en BD (D3).
  xmlStorageKey               String?
  cdrStorageKey               String?
  pdfStorageKey               String?
  tokenConsulta               String?           @unique
  tokenConsultaCreatedAt      DateTime?

  // LEGACY: contenido en BD. Vaciar y migrar a MinIO en doc 07.
  xmlContent                  String?
  cdrContent                  String?
  codigoSunat                 String?
  mensajeSunat                String?
  hashSunat                   String?
  fechaEnvio                  DateTime?
  // Doc 04 §5.2 — fecha en que SUNAT entregó la CDR. Ancla del plazo de 7
  // días calendario para comunicación de baja (RA). Si es null, se cae al
  // legacy `fechaEmision` con un warn en logs.
  cdrRecibidaAt               DateTime?
  intentosEnvio               Int               @default(0)

  fechaEmision                DateTime          @default(now())
  emitidoPor                  String?           // userId que dispar\u00f3 la emisi\u00f3n
  observaciones               String?

  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  venta              Venta?                @relation(fields: [ventaId], references: [id])
  detallesFiscales   ComprobanteDetalle[]
  envioLogs          ComprobanteEnvioLog[]
  portalAccessLogs   PortalAccessLog[]
  emailLogs          ComprobanteEmailLog[]
  comunicacionesBaja ComunicacionBaja[]

  @@index([ventaId])
  @@index([estado])
  @@index([fechaEmision])
  @@index([tipo, serie])
  @@index([comprobanteOrigenId])
  @@index([fechaVencimientoPlazo])
  @@map("comprobantes")
}

