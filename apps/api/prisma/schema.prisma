// NotaCredito y NotaDebito legacy eliminados (doc 01 §arch + doc 08 §1).
// El modelo unificado vive en `Comprobante` con `tipo = NOTA_CREDITO/NOTA_DEBITO`
// y `comprobanteOrigenId` apuntando al CPE origen vía la self-rel "ComprobanteNotas".
// Migración de datos: 20260506200000_unificar_comprobante_notas.

// Doc 08 §3 — Feriados nacionales y declarados no laborables, usados para
// calcular el plazo de 10 días hábiles de las NC excepcionales. Mantenible
// manualmente por año (la lista de feriados PE no cambia frecuentemente
// pero se decretan días no laborables específicos por DS).
model FeriadoNacional {
  id        String   @id @default(uuid())
  fecha     DateTime @db.Date
  nombre    String
  anio      Int
  esNoLaborable Boolean @default(false) // distingue feriado oficial vs DS no laborable
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([fecha])
  @@index([anio])
  @@map("feriados_nacionales")
}

model Garantia {
