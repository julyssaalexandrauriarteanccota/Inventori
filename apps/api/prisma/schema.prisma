  clienteIdOriginal String?
  clienteDocTipo    String?
  clienteDocNumero  String?
  clienteNombre     String?
  fechaInicio       DateTime
  fechaFin          DateTime
  cobertura         String
  exclusiones       String?
    fechaInstalacion  DateTime?
    direccionInstalacion String?
    ubigeoInstalacion String?
    departamentoInstalacion String?
    provinciaInstalacion String?
    distritoInstalacion String?
    latitudInstalacion Float?
    longitudInstalacion Float?
    contactoInstalacion String?
    telefonoInstalacion String?
  notasInstalacion String?
  contadorInicio    Int?
  contadorMaxCopias Int?
  estado            EstadoGarantia @default(PENDIENTE_COMPLETAR)
  codigoQR          String         @unique
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  equipo Equipo         @relation(fields: [equipoId], references: [id])
  venta  Venta?         @relation(fields: [ventaId], references: [id])
  contratoAlquiler ContratoAlquiler? @relation(fields: [contratoAlquilerId], references: [id])
  casos  CasoGarantia[]

  @@index([equipoId])
  @@index([ventaId])
  @@index([contratoAlquilerId])
  @@map("garantias")
}

model CasoGarantia {
  id          String   @id @default(uuid())
  garantiaId  String
  ticketId    String?
  descripcion String
  resolucion  String?
  aceptada    Boolean?
  motivo      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  garantia Garantia @relation(fields: [garantiaId], references: [id])
  ticket   Ticket?  @relation(fields: [ticketId], references: [id])

  @@index([garantiaId])
  @@index([ticketId])
  @@map("casos_garantia")
}

model Ticket {
  id             String          @id @default(uuid())
  codigo         String          @unique
  clienteId      String
  equipoId       String?
  clienteEquipoId String?
  tecnicoId      String?
  creadoPorId    String
  titulo         String
  descripcion    String
  fallaReportada String?
  prioridad      PrioridadTicket @default(MEDIA)
  estado         EstadoTicket    @default(ABIERTO)
  tipoServicio   TipoServicio    @default(TALLER)
  diagnostico    String?
  solucion       String?
  montoManoObra  Decimal?        @db.Decimal(10, 2)
  montoRepuestos Decimal?        @db.Decimal(10, 2)
  montoTotal     Decimal?        @db.Decimal(10, 2)
  fechaRecepcion DateTime        @default(now())
  fechaPromesa   DateTime?
  fechaCierre    DateTime?
  firmaCliente   String?
  firmaFecha     DateTime?
  firmaGeoLat    Float?
  firmaGeoLng    Float?
  notas          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  cliente       Cliente           @relation(fields: [clienteId], references: [id])
  equipo        Equipo?           @relation(fields: [equipoId], references: [id])
  clienteEquipo EquipoClienteActivo? @relation(fields: [clienteEquipoId], references: [id])
  tecnico       Usuario?          @relation("TecnicoTickets", fields: [tecnicoId], references: [id])
  creadoPor     Usuario           @relation("CreadorTickets", fields: [creadoPorId], references: [id])
  detalles      DetalleTicket[]
  adjuntos      AdjuntoTicket[]
  historial     HistorialTicket[]
  casosGarantia CasoGarantia[]
  cargosAlquiler CargoPeriodoAlquiler[]

  @@index([clienteId])
  @@index([equipoId])
  @@index([clienteEquipoId])
  @@index([tecnicoId])
  @@index([creadoPorId])
  @@index([estado])
  @@map("tickets")
}

model DetalleTicket {
  id               String   @id @default(uuid())
  ticketId         String
  productoId       String
  cantidad         Int
  precioUnitario   Decimal  @db.Decimal(10, 2)
  cubiertoGarantia Boolean  @default(false)
  notas            String?
  createdAt        DateTime @default(now())

  ticket   Ticket   @relation(fields: [ticketId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  @@index([ticketId])
  @@index([productoId])
  @@map("detalles_ticket")
}

model AdjuntoTicket {
  id        String   @id @default(uuid())
  ticketId  String
  url       String
  nombre    String
  tipo      String
  tamano    Int?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("adjuntos_ticket")
}

model HistorialTicket {
  id           String   @id @default(uuid())
  ticketId     String
  usuarioId    String?
  campo        String
  valorAntes   String?
  valorDespues String?
  notas        String?
  createdAt    DateTime @default(now())

  ticket  Ticket   @relation(fields: [ticketId], references: [id])
  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([ticketId])
  @@index([usuarioId])
  @@map("historial_tickets")
}

model ConfigEmpresa {
