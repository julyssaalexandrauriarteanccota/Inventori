# Base de datos
DATABASE_URL="postgresql://postgres:POSTGRES@localhost:5433/erp_db"

# Auth
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_IN="30d"

# Redis
REDIS_URL="redis://localhost:6379"

# Servicio AI
AI_SERVICE_URL="http://localhost:8000"
AI_INTERNAL_KEY=""

# Anthropic
ANTHROPIC_API_KEY=""

# SUNAT (emisión directa por SOAP — ver docs/handoff-arquitectura-escalable.md)
# Las credenciales SOL viven cifradas en BD vía FiscalSecret (apps/api).
SUNAT_ENVIRONMENT="BETA"
SUNAT_DIRECT_DEV_MODE="true"
SUNAT_SOAP_TIMEOUT_MS="30000"
SUNAT_BETA_URL="https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService"
SUNAT_PRODUCCION_URL="https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService"
# Fallback local para desarrollo si aún no se guardaron credenciales cifradas.
SUNAT_SOL_USERNAME=""
SUNAT_SOL_USER=""
SUNAT_SOL_PASSWORD=""
# 32 bytes codificados en base64. Ejemplo: `openssl rand -base64 32`.
FISCAL_MASTER_KEY_BASE64=""
FISCAL_MASTER_KEY_VERSION="v1"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# App
NODE_ENV="development"
PORT_API="4000"
FRONTEND_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# File Storage
UPLOAD_DRIVER="local"
UPLOAD_LOCAL_PATH="./uploads"
S3_ENDPOINT="http://minio:9000"
S3_BUCKET="erp-uploads"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Consulta documental de clientes (DNI/RUC)
DECOLECTA_API_TOKEN=""
DECOLECTA_API_BASE_URL="https://api.decolecta.com"
DECOLECTA_TIMEOUT_MS="8000"
APISPERU_API_TOKEN=""
APISPERU_API_BASE_URL="https://dniruc.apisperu.com/api/v1"
APISPERU_TIMEOUT_MS="8000"
DOCUMENT_LOOKUP_PROVIDER_ORDER="DECOLECTA,APISPERU"
SUNAT_PADRON_RUC_URL="https://www.sunat.gob.pe/descargaPRR/padron_reducido_ruc.zip"


# MinIO (Doc 09 — almacenamiento documental fiscal)
# Root admin: usado solo por minio-init para crear buckets, users y políticas.
MINIO_ROOT_USER="erp_minio_user"
MINIO_ROOT_PASSWORD="erp_minio_password"
# IAM users con permisos mínimos. Backend usa erp-app; portal lee con erp-portal.
MINIO_APP_ACCESS_KEY="erp-app"
MINIO_APP_SECRET_KEY="erp-app-secret-change-me"
MINIO_PORTAL_ACCESS_KEY="erp-portal"
MINIO_PORTAL_SECRET_KEY="erp-portal-secret-change-me"
# Cliente del backend (apuntar a las credenciales erp-app, no root).
FISCAL_STORAGE_PROVIDER="MINIO"
FISCAL_PRIVATE_STORAGE_DIR="./private-fiscal-storage"
FISCAL_STORAGE_BUCKET="cpe-beta"
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="erp-app"
MINIO_SECRET_KEY="erp-app-secret-change-me"
MINIO_BUCKET_CPE_BETA="cpe-beta"
MINIO_BUCKET_CPE_PRODUCCION="cpe-produccion"
MINIO_BUCKET_BAJAS_BETA="bajas-beta"
MINIO_BUCKET_BAJAS_PRODUCCION="bajas-produccion"
MINIO_BUCKET_TEMP_UPLOADS="temp-uploads"

# Backup
BACKUP_ENABLED="true"
BACKUP_CRON="0 2 * * *"
BACKUP_RETENTION_DAYS="30"
BACKUP_PATH="/backups"
# Backup MinIO (mc mirror diario de buckets de producción).
MINIO_BACKUP_ENABLED="true"
MINIO_BACKUP_RETENTION_DAYS="30"
